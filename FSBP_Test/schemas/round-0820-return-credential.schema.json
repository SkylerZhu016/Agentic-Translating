{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-translating.local/schemas/round-0820-return-credential.schema.json",
  "title": "Round 0820 Human Review Return Credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roundId",
    "namespace",
    "credentialKind",
    "packetId",
    "packetHash",
    "reviewerPackageId",
    "reviewerToken",
    "reviewerTokenHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "roundId": { "const": "round-0820" },
    "namespace": { "const": "fsbp" },
    "credentialKind": { "const": "human_review_return_credential" },
    "packetId": { "type": "string", "minLength": 1 },
    "packetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerPackageId": { "type": "string", "pattern": "^rp-[a-f0-9]{24}$" },
    "reviewerToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerTokenHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
