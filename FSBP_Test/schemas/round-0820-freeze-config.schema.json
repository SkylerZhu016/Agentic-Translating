{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-translating.local/schemas/round-0820-freeze-config.schema.json",
  "title": "Round 0820 Freeze Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roundId",
    "seed",
    "datasets",
    "promptFiles",
    "promptBundle",
    "models",
    "parameters",
    "endpoint"
  ],
  "properties": {
    "roundId": { "const": "round-0820" },
    "mode": { "enum": ["development", "formal"] },
    "determinismLevel": { "enum": ["full", "partial", "none"] },
    "annotationVersion": { "type": "string", "minLength": 1 },
    "annotationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "seed": { "type": "string", "minLength": 1 },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "required": ["quality"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "expectedCount"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["quality", "annotation_isolation"] },
          "expectedCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "promptFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "promptBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "analysis", "candidate", "stages"],
      "properties": {
        "direct": { "type": "string", "minLength": 1 },
        "analysis": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "candidate": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review", "filter", "orchestrate", "assemble"],
          "properties": {
            "review": { "type": "string", "minLength": 1 },
            "filter": { "type": "string", "minLength": 1 },
            "orchestrate": { "type": "string", "minLength": 1 },
            "assemble": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "analysis", "candidates", "editor", "fallbackModel"],
      "properties": {
        "direct": { "const": "GPT 5.6 Sol: CPA" },
        "analysis": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "GPT 5.6 Sol: CPA" },
            { "const": "GPT 5.6 Sol: CPA" }
          ],
          "items": false
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "GPT 5.6 Sol: CPA" },
            { "const": "GPT 5.6 Sol: CPA" },
            { "const": "GPT 5.6 Sol: CPA" }
          ],
          "items": false
        },
        "editor": {
          "const": "GPT 5.6 Sol: CPA",
          "description": "The shared binding for review, filter, orchestrate, and assemble."
        },
        "fallbackModel": { "const": "GPT 5.6 Sol: CPA" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "maxTokens", "timeoutMs", "retries", "sampleConcurrency", "fallbackAttempts"],
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxTokens": { "const": 131072 },
        "timeoutMs": { "const": 900000 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "sampleConcurrency": { "const": 5 },
        "fallbackAttempts": { "const": 1 }
      }
    },
    "toolLimits": { "type": "object", "additionalProperties": true },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "chatCompletionsPath", "apiKeyEnv"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "chatCompletionsPath": { "type": "string", "minLength": 1, "pattern": "^/" },
        "apiKeyEnv": { "const": "FSBP_EXPERIMENT_API_KEY" }
      }
    }
  }
}
