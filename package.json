{
  "name": "agentic-translating",
  "version": "0.2.0",
  "description": "A bidirectional, multi-model translation deliberation and evidence-based editing workspace.",
  "author": "SkylerZhu",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/launch-desktop.mjs --web-dev",
    "build": "node scripts/launch-desktop.mjs --build",
    "start": "next start",
    "test": "vitest run",
    "test:cli": "vitest run test/cli/dev-harness.test.ts",
    "test:watch": "vitest",
    "lint": "next lint",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "e2e": "npm run build:standalone && playwright test",
    "build:standalone": "npm run build && node scripts/prepare-standalone.mjs && node scripts/verify-release-tree.mjs && node scripts/smoke-standalone.mjs",
    "verify:release-tree": "node scripts/verify-release-tree.mjs",
    "verify:standalone-smoke": "node scripts/smoke-standalone.mjs",
    "desktop": "node scripts/launch-desktop.mjs",
    "desktop:preview": "node scripts/launch-desktop.mjs --preview",
    "icon:build": "node scripts/generate-icon.mjs",
    "package:win": "node scripts/package-win.mjs",
    "dataset:validate": "node scripts/validate-fsbp-dataset.mjs",
    "dataset:validate:locked": "node scripts/validate-fsbp-dataset.mjs --locked",
    "harness": "node --experimental-strip-types scripts/dev-harness.mts",
    "experiment:quality": "node --experimental-strip-types scripts/run-fsbp-quality-experiment.mjs",
    "experiment:blind": "node scripts/prepare-fsbp-blind-review.mjs",
    "experiment:blind:b2": "node scripts/build-fsbp-b2-blind-review.mjs",
    "experiment:blind:decode": "node scripts/decode-fsbp-blind-review.mjs",
    "experiment:round0820:freeze": "node scripts/freeze-round-0820.mjs",
    "experiment:round0820:run": "node scripts/run-round-0820.mjs",
    "experiment:round0820:run:legacy-key-file": "node scripts/run-round-0820-with-key-file.mjs",
    "experiment:round0820:blind": "node scripts/prepare-round-0820-blind.mjs",
    "experiment:round0820:human": "node scripts/validate-round-0820-human.mjs",
    "experiment:round0820:analyze": "node scripts/analyze-round-0820.mjs",
    "experiment:gate:round2": "node scripts/run-round2-five-sample-gate.mjs",
    "experiment:gate:round2:blind": "node scripts/build-round2-gate-blind-review.mjs",
    "experiment:verdict:validate": "node scripts/validate-gate-verdict.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "fast-array-diff": "^1.1.0",
    "jszip": "^3.10.1",
    "next": "^15.5.21",
    "pinyin-pro": "^3.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.0"
  },
  "build": {
    "appId": "com.agentictranslating.desktop",
    "productName": "Agentic Translating",
    "files": [
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}",
      "splashImage": "build/portable-splash.bmp"
    }
  }
}
